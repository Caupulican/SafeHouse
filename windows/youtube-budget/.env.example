# SafeHouse - YouTube watch-time budget.
# Copy to .env (next to install.py) and edit, then apply with:
#
#   C:\SafeHouse\python\python.exe .\install.py
#
# install.py renders this into C:\ProgramData\SafeHouse\config.json, which is what
# the watcher actually reads. Anything you do NOT set here keeps its current live value,
# so re-running the installer will not clobber a bonus granted with youtube-budget-ctl.
#
# All values are positive integers. A bad value is warned about and ignored, never
# silently applied - a typo must not hand out unlimited YouTube.


# ---------------------------------------------------------------------------
# THE ONE YOU ACTUALLY CARE ABOUT
# ---------------------------------------------------------------------------
# Daily YouTube watch-time budget, in minutes. Resets at local midnight.
# This is a CUMULATIVE budget (spend it whenever), not a time-of-day window.
#   60 = 1 h    120 = 2 h    180 = 3 h
YB_LIMIT_MIN=60


# ---------------------------------------------------------------------------
# METERING TUNABLES - the defaults are good; change only if you know why
# ---------------------------------------------------------------------------

# Seconds between samples. Also the granularity of the budget: watch time is credited
# in whole samples, so a smaller value is more accurate but wakes up more often.
YB_SAMPLE_SEC=20

# Rolling window (seconds) the throughput test averages over. Long enough that a paused
# video or an ad break does not immediately stop the clock, short enough that a closed
# tab does. Must be a multiple of YB_SAMPLE_SEC to be meaningful.
YB_WINDOW_SEC=240

# Inbound throughput from pinned YouTube IPs, in kbit/s, above which the sample counts
# as "watching". Set it too low and a background tab burns budget; too high and low
# quality playback is not metered at all. 64 catches 144p with margin.
YB_MIN_THROUGHPUT_KBPS=64

# Drop a pinned YouTube IP after this many minutes with no traffic. Keeps the pin set
# under the 32-filter cap as the CDN rotates endpoints.
YB_PIN_IDLE_EXPIRE_MIN=30


# ---------------------------------------------------------------------------
# NOT SETTABLE HERE (deliberately)
# ---------------------------------------------------------------------------
# bonus_sec  - extra time for today only. It is a live grant, not config:
#                python.exe -m safehouse_ytbudget.cli grant 30
# The blocked host list lives in ..\parental-blocks\youtube.txt.
