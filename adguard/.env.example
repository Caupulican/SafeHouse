# Copy to .env (next to docker-compose.yml) and adjust.
# Web dashboard + setup wizard port on the host (http://localhost:<port>)
# Pi-hole keeps 8053; AdGuard Home uses 3000 so both dashboards coexist.
ADGUARD_WEB_PORT=3000

# Timezone (affects dashboard timestamps + the Blocked Services schedule!)
# Get the schedule wrong by a timezone and the YouTube window opens at the wrong hour.
ADGUARD_TZ=Etc/UTC

# Container name
ADGUARD_CONTAINER=adguardhome

# NOT read by docker-compose - set inside the AdGuard Home UI (Settings -> DNS settings
# -> Upstream DNS servers). Recorded here so the intended chain is documented in one
# place. Both containers share WSL's host network; Pi-hole owns the secondary port.
ADGUARD_UPSTREAM=127.0.0.1:5353
