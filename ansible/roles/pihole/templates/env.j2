{{ ansible_managed | comment }}
# Rendered by the SafeHouse ansible 'pihole' role. Edit group_vars/all.yml or the role
# defaults and re-run the playbook; changes made here are overwritten.

# The WSL2 eth0 IP Pi-hole binds DNS to. Changes across reboots, so it is re-detected
# on every run -- binding here rather than 0.0.0.0 dodges the 10.255.255.254:53 WSL
# DNS-tunnel listener.
PIHOLE_BIND_IP={{ wsl_ip }}

# 53 = Pi-hole is the only resolver. 5353 = AdGuard Home owns :53 and forwards here.
PIHOLE_DNS_PORT={{ pihole_dns_port }}

PIHOLE_WEB_PORT={{ pihole_web_port }}
PIHOLE_PASSWORD={{ pihole_password_effective }}
PIHOLE_TZ={{ pihole_tz }}
PIHOLE_UPSTREAMS={{ pihole_upstreams }}
PIHOLE_CONTAINER={{ pihole_container }}
