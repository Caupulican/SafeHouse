# Rendered by the SafeHouse ansible 'adguard' role. Edit group_vars/all.yml or the role
# defaults and re-run the playbook; changes made here are overwritten.

ADGUARD_WEB_PORT={{ adguard_web_port }}
ADGUARD_TZ={{ adguard_tz }}
ADGUARD_CONTAINER={{ adguard_container }}

# Not read by docker-compose. Set this as the upstream inside the AdGuard Home UI
# (Settings -> DNS settings -> Upstream DNS servers) during the first-run wizard.
ADGUARD_UPSTREAM=127.0.0.1:5353
